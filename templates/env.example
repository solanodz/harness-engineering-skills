# Copy to .env and fill in values. Never commit .env.
# required = agent/app will not start without it
# optional = has a safe default

# --- required ---
# DATABASE_URL=postgres://user:pass@localhost:5432/app
# API_SECRET=changeme

# --- optional ---
# LOG_LEVEL=info
# PORT=3000

# --- CI / production only (leave empty locally) ---
# SENTRY_DSN=
